// # Figure JSON Serialization Subsystem
//
// Logline: Formats machine-readable JSON payloads for figure layouts, dimensions, and styles.
//
// Setup: Pure string serialization conforming to RFC 8259 JSON format.
//
// Beats:
//   1. Escape strings for strict JSON conformance.
//   2. Serialize figure geometry, line counts, and rendered text.
//   3. Serialize catalog of supported border styles and glyph definitions.
//   4. Deliver structured payloads for automated pipelines and AI agents.

import "core/box_styles.oo";

fn json_str_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b == 92 {
            out = out + "\\\\";
        } else if b == 34 {
            out = out + "\\\"";
        } else if b == 10 {
            out = out + "\\n";
        } else if b == 13 {
            out = out + "\\r";
        } else if b == 9 {
            out = out + "\\t";
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

pub fn render_figure_json(rendered_text: String, style_name: String, width: Int, lines_count: Int) -> String {
    let mut out: String = "{\n"
        + "  \"figure_type\": \"box\",\n"
        + "  \"style\": \"" + json_str_escape(style_name) + "\",\n"
        + "  \"width\": " + width.to_string() + ",\n"
        + "  \"line_count\": " + lines_count.to_string() + ",\n"
        + "  \"rendered\": \"" + json_str_escape(rendered_text) + "\"\n"
        + "}\n";
    return out;
}

pub fn render_styles_list_json() -> String {
    let names: List[String] = list_style_names();
    let n: Int = list_len(names);
    let mut out: String = "{\n  \"styles\": [";
    let mut i: Int = 0;
    while i < n {
        let name: String = list_get(names, i);
        let st: BoxStyle = get_box_style(name);
        out = out + "\n    {"
            + "\"name\": \"" + name + "\", "
            + "\"top_left\": \"" + st.top_left + "\", "
            + "\"top_right\": \"" + st.top_right + "\", "
            + "\"horizontal\": \"" + st.horizontal + "\", "
            + "\"vertical\": \"" + st.vertical + "\""
            + "}";
        if i + 1 < n {
            out = out + ",";
        }
        i = i + 1;
    }
    out = out + "\n  ]\n}\n";
    return out;
}
