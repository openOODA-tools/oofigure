// # Box Figure Engine
//
// Logline: Spatial geometry calculation, string repetition, line alignment, and padding routines.
//
// Setup: Pure string and geometric transformation algorithms without ambient system calls.
//
// Beats:
//   1. Split raw multiline text into structured line records.
//   2. Compute maximum content width across lines.
//   3. Generate repeated glyph sequences for horizontal border bars.
//   4. Align and pad text lines within bounded inner box dimensions.

pub fn repeat_glyph(glyph: String, count: Int) -> String {
    let mut out: String = "";
    let mut i: Int = 0;
    while i < count {
        out = out + glyph;
        i = i + 1;
    }
    return out;
}

pub fn split_text_lines(text: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let n: Int = chars_len(text);
    let mut start: Int = 0;
    let mut i: Int = 0;

    while i < n {
        if byte_at(text, i) == 10 {
            let line: String = str_slice(text, start, i);
            lines = list_push(lines, line);
            start = i + 1;
        } else if byte_at(text, i) == 92 && i + 1 < n && byte_at(text, i + 1) == 110 {
            let line_esc: String = str_slice(text, start, i);
            lines = list_push(lines, line_esc);
            start = i + 2;
            i = i + 1;
        }
        i = i + 1;
    }

    if start <= n {
        let last_line: String = str_slice(text, start, n);
        lines = list_push(lines, last_line);
    }

    return lines;
}

pub fn max_line_width(lines: List[String]) -> Int {
    let n: Int = list_len(lines);
    let mut max_w: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let line: String = list_get(lines, i);
        let w: Int = chars_len(line);
        if w > max_w {
            max_w = w;
        }
        i = i + 1;
    }
    return max_w;
}

pub fn align_text_line(line: String, inner_w: Int, align: String) -> String {
    let w: Int = chars_len(line);
    if w >= inner_w {
        return line;
    }
    let diff: Int = inner_w - w;
    if align == "right" {
        return repeat_glyph(" ", diff) + line;
    }
    if align == "center" {
        let left_pad: Int = diff / 2;
        let right_pad: Int = diff - left_pad;
        return repeat_glyph(" ", left_pad) + line + repeat_glyph(" ", right_pad);
    }
    return line + repeat_glyph(" ", diff);
}
